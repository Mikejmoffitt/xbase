#include	"xbase/xbase.h"

#define VBL_VECTOR XB_MFP_INT_VDISP

	.global	g_vbl_count
	.global	xb_vbl_wait_init
	.global	xb_vbl_wait

	.section	.bss
g_vbl_count:             ds.l 1
s_vbl_wait_flag:         ds.b 1
	.section	.text

// TODO: Is this the start or end of VDISP?
vbl_isr:
	sf	s_vbl_wait_flag
	addq.l	#1, g_vbl_count
	rte

; void *xb_vbl_wait_init(void)
xb_vbl_wait_init:
	pea	vbl_isr
	moveq	#0, d0
	move.w	#VBL_VECTOR, d0
	move.l	d0, -(sp)
	jsr	xb_mfp_set_interrupt
	lea	8(sp), sp
	move.l	d0, -(sp)  ; return value

	moveq	#-1, d0    ; true
	move.l	d0, -(sp)
	add.w	#VBL_VECTOR+1, d0  ; 1 to make d0 0, then VBL_VECTOR
	move.l	d0, -(sp)
	jsr	xb_mfp_set_interrupt_enable
	lea	8(sp), sp
	move.l	(sp)+, d0
	rts

; void xb_vbl_wait(void)
xb_vbl_wait:
	st	s_vbl_wait_flag
0:
	tst.b	s_vbl_wait_flag
	bne.s	0b
	rts
