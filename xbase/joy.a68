	#include	"xbase/xbase.h"

#define REPEAT_DELAY 15
#define REPEAT_RATE  2

	.section	.bss
	.global		g_xb_joy

g_xb_joy:		ds.b XBJoy.len*XB_JOY_COUNT

	.section	.text
	
	.global		xb_joy_init
	.global		xb_joy_poll

// Clears joypad state and sets default polling mode.
; void xb_joy_init(void)
xb_joy_init:
	moveq	#0, d0
	moveq	#XB_JOY_MODE_STANDARD, d1
	lea	g_xb_joy, a0
	.rept	XB_JOY_COUNT
	move.w	d1, (a0)+  ; set mode field
	move.l	d0, (a0)+  ; clear out state
	move.l	d0, (a0)+  ; "
	.endr
	rts

// Samples inputs and calculates edges. Call before game logic.
; void xb_joy_poll(void)
xb_joy_poll:
	lea	g_xb_joy, a0
	lea	XB_JOY_BASE, a1
	bsr.b	joy_poll_sub
	lea	XBJoy.len(a0), a0
	addq.w	#2, a1
	; fall-through to joy_poll_sub

; a0 = sub
; a1 = input base
joy_poll_sub:
	move.w	XBJoy.now(a0), d2
;
; Data In
;
	moveq	#0, d0
	move.b	(a1), d0  ; read from hardware port
	not.b	d0
;	tst.w	XBJoy.mode(a0)
;	bne.w	sample_sixbutton  TODO
	; Read extended buttons based on illegal switch combos
	move.w	d0, d1
	andi.w	#XB_BTN_UP | XB_BTN_DOWN, d1
	cmpi.w	#XB_BTN_UP | XB_BTN_DOWN, d1
	bne.s	0f
	ori.w	#XB_BTN_SELECT, d0
	andi.w	#~(XB_BTN_UP | XB_BTN_DOWN), d0
0:
	move.w	d0, d1
	andi.w	#XB_BTN_LEFT | XB_BTN_RIGHT, d1
	cmpi.w	#XB_BTN_LEFT | XB_BTN_RIGHT, d1
	bne.s	1f
	ori.w	#XB_BTN_START, d0
	andi.w	#~(XB_BTN_LEFT | XB_BTN_RIGHT), d0
1:
	move.w	d0, XBJoy.now(a0)
;
; Edge Update
;
	move.w	d2, XBJoy.prev(a0)
	swap	d0
	move.w	d2, d0  ; now in upper, prev in lower
	move.l	d0, d2  ; back up
	move.l	d0, d1
	swap	d1      ; now in lower

;
; Key Repeat capture
;
	cmp.w	d0, d1
	beq.s	0f
; different key
	move.w	d1, XBJoy.rept_data(a0)
	clr.w	XBJoy.rept_cnt(a0)
	bra.s	1f
0:
; same key
	addq.w	#1, XBJoy.rept_cnt(a0)
1:
;
; Negative Edge
;
	not.w	d1
	and.w	d1, d0
	move.w	d0, XBJoy.neg(a0)
;
; Positive edge
;
	move.l	d2, d1  ; now/prev copy from before
	swap	d2
	not.w	d1
	and.w	d1, d2
	move.w	d2, XBJoy.pos(a0)
;
; Key Repeat Out. d2.w is still pos
;
	move.w	XBJoy.rept_cnt(a0), d1  ; counting?
	cmpi.w	#REPEAT_DELAY, d1
	bne.s	0f
	subq.w	#REPEAT_RATE, d1  ; retrigger
	move.w	d1, XBJoy.rept_cnt(a0)
	or.w	XBJoy.rept_data(a0), d2  ; pos | rept
0:
	move.w	d2, XBJoy.pos_r(a0)

	rts
