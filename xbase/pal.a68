#include	"xbase/xbase.h"

	.global		xb_pal_init
	.global		xb_pal_poll
	.global		g_xb_pal
	.global		g_xb_pal_dirty

	.section	.bss
; Bitfield indicating that a palette line needs to be copied
g_xb_pal_dirty:         ds.l 1
; Palette buffer
g_xb_pal:               ds.w XB_PAL_COUNT

	.section	.text

; void xb_pal_init(void);
xb_pal_init:
	; Zero out the palette buffer
	moveq	#0, d0
	moveq	#(XB_PAL_COUNT/4)-1, d1
	lea	g_xb_pal, a0
init_loop:
	.rept	4
	move.l	d0, (a0)+
	.endr
	dbf	d1, init_loop
	; mark all palettes as in need of a transfer.
	move.l	#XB_PAL_DIRTY_MASK_FULL, g_xb_pal_dirty
	rts

; void xb_pal_poll(void);

#define POLL_CLOBBER d3-d5/a3-a5

xb_pal_poll:
	move.l	g_xb_pal_dirty, d0
	beq.s	poll_ret

	movem.l	POLL_CLOBBER, -(sp)

	moveq	#XB_PAL_LINE_SIZE*2, d1  ; advance offset
	lea	g_xb_pal, a0
	lea	XB_VIDCON_GP_PAL_BASE, a1
poll_loop:
	tst.l	d0
	beq.s	poll_loop_done
	lsr.l	#1, d0  ; get dirty bit into carry
	bcc.s	0f      ; not requested --> skip this line
	; Copying one whole palette at a time
	movem.l	(a0)+, d2-d5/a2-a5
	movem.l	d2-d5/a2-a5, (a1)
	adda.l	d1, a1  ; dest advance
	bra.s	poll_loop

0:  ; skip source, advance dest, go again
	adda.l	d1, a0
	adda.l	d1, a1
	bra.s	poll_loop

poll_loop_done:
	clr.l	g_xb_pal_dirty
	movem.l	(sp)+, POLL_CLOBBER
poll_ret:
	rts
